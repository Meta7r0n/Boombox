{
  "name": "oto",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {"directory": "dist/cloudflare", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "SITE_ORIGIN": "",
    "SITE_PAGES": "[]",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [{"binding": "DB", "database_name": "oto", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "oto-audio"}],
  "env": {
    "local": {
      "name": "oto-local",
      "vars": {"OTO_LOCAL_AUTH": "true", "SITE_ORIGIN": "", "SITE_PAGES": "[]"},
      "d1_databases": [{"binding": "DB", "database_name": "oto-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle"}],
      "r2_buckets": [{"binding": "BUCKET", "bucket_name": "oto-local-audio"}]
    }
  }
}
